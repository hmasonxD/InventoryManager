@model IEnumerable<InventoryManager.Models.Product>

@{
    ViewData["Title"] = "Products";
    var categories = ViewData["Categories"] as List<InventoryManager.Models.Category>;
}

<h2 class="mb-4">Products</h2>

<!-- Search & Filter Bar -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control"
                       placeholder="Search by name or description..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Category</label>
                <select name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @if (categories != null)
                    {
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(ViewData["CurrentCategory"]?.ToString() == cat.Id.ToString())">
                                @cat.Name
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Products Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Product List (@Model.Count() items)</h5>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success btn-sm">+ Add Product</a>
        }
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSort"]"
                               asp-route-searchString="@ViewData["CurrentSearch"]"
                               asp-route-categoryId="@ViewData["CurrentCategory"]" class="text-decoration-none text-dark">
                            Name ⇅
                        </a>
                    </th>
                    <th>Category</th>
                    <th>Supplier</th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["PriceSort"]"
                               asp-route-searchString="@ViewData["CurrentSearch"]"
                               asp-route-categoryId="@ViewData["CurrentCategory"]" class="text-decoration-none text-dark">
                            Price ⇅
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index" asp-route-sortOrder="@ViewData["QtySort"]"
                               asp-route-searchString="@ViewData["CurrentSearch"]"
                               asp-route-categoryId="@ViewData["CurrentCategory"]" class="text-decoration-none text-dark">
                            Quantity ⇅
                        </a>
                    </th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Category?.Name</td>
                        <td>@item.Supplier?.CompanyName</td>
                        <td>@item.Price.ToString("C")</td>
                        <td>@item.Quantity</td>
                        <td>
                            @if (item.IsLowStock)
                            {
                                <span class="badge bg-danger">Low Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">In Stock</span>
                            }
                        </td>
                        <td>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            }
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>