@model IEnumerable<InventoryManager.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<h2 class="mb-4">Orders</h2>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">All Orders (@Model.Count())</h5>
        <a asp-action="Create" class="btn btn-success btn-sm">+ New Order</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>#@item.Id</strong></td>
                        <td>@item.OrderDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            <span
                                class="badge bg-@(item.Status == InventoryManager.Models.OrderStatus.Delivered ? "success" :
                                                                                                                                                                                                                                                                                                                                                              item.Status == InventoryManager.Models.OrderStatus.Cancelled ? "danger" :
                                                                                                                                                                                                                                                                                                                                                              item.Status == InventoryManager.Models.OrderStatus.Shipped ? "info" : "warning")">
                                @item.Status
                            </span>
                        </td>
                        <td>@item.OrderItems.Count item(s)</td>
                        <td>@item.TotalAmount.ToString("C")</td>
                        <td>@item.Notes</td>
                        <td>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            }
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>